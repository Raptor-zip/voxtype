# Build environment for the voxtype Vulkan binary that runs on Ubuntu 22.04
# (glibc 2.35) and anything newer.
#
# WHY THIS EXISTS: Dockerfile.vulkan builds on ubuntu:24.04 because 24.04 ships
# `glslc` in apt. The resulting binary needs glibc 2.38+ (2.39 for the ONNX
# variants), so it will not start on Ubuntu 22.04, Debian 12, or RHEL 9 and
# derivatives. The CPU variants (baseline, avx2) are built on 22.04 and run
# there, which leaves GPU users on those distros with no prebuilt binary.
#
# The only reason 24.04 was needed is the shader compiler. 22.04 has no `glslc`
# package, and its libvulkan-dev (1.3.204) is older than what ggml-vulkan
# expects. So this image keeps the 22.04 toolchain (and therefore the glibc
# floor) and takes `glslc` plus matching Vulkan headers from the LunarG Vulkan
# SDK, pinned by version and sha256.
#
# The binary still links the system libvulkan.so.1 at runtime; users need the
# `libvulkan1` package and a Vulkan driver, same as the 24.04 build.
#
# NOTE: This build can take 30+ minutes single-threaded. For a local build you
# can raise the parallelism:
#   docker build -f Dockerfile.vulkan-ubuntu22 --build-arg BUILD_JOBS=8 -t voxtype-vulkan-ubuntu22 .
#
# Usage:
#   docker build -f Dockerfile.vulkan-ubuntu22 -t voxtype-vulkan-ubuntu22 .
#   docker run --rm -v $(pwd)/releases:/output voxtype-vulkan-ubuntu22
#
FROM ubuntu:22.04

ARG VERSION=1.1.0
ARG DEBIAN_FRONTEND=noninteractive
# Single-threaded by default: parallel builds have deadlocked cmake in CI
# (see Dockerfile.vulkan). Raise it only for local experiments.
ARG BUILD_JOBS=1
# The glibc floor this image exists to guarantee. The build fails if the binary
# needs anything newer.
ARG MAX_GLIBC=2.35
ARG VULKAN_SDK_VERSION=1.4.304.1
# sha256 of vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz, as published at
# https://sdk.lunarg.com/sdk/sha/${VULKAN_SDK_VERSION}/linux/vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz.txt
ARG VULKAN_SDK_SHA256=92d698f12a968b024e2b593037830262785b2b734553683457719d4da7c5b0d6

ENV VERSION=${VERSION}

RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    xz-utils \
    build-essential \
    clang \
    cmake \
    pkg-config \
    libasound2-dev \
    libx11-dev \
    libxi-dev \
    libxtst-dev \
    libgtk-3-dev \
    libglib2.0-dev \
    libappindicator3-dev \
    git \
    binutils \
    libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

# libvulkan-dev above supplies the libvulkan.so the final link needs (-lvulkan).
# It is deliberately the distro's loader and not the SDK's: linking against the
# 22.04 loader keeps the binary loadable with the stock libvulkan1 package.
#
# Vulkan SDK: shader compiler (glslc) and headers only. Extract the x86_64 tree
# and drop everything else.
RUN curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/vulkan-sdk.tar.xz \
        "https://sdk.lunarg.com/sdk/download/${VULKAN_SDK_VERSION}/linux/vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz" \
    && echo "${VULKAN_SDK_SHA256}  /tmp/vulkan-sdk.tar.xz" | sha256sum -c - \
    && mkdir -p /opt/vulkan \
    && tar -xJf /tmp/vulkan-sdk.tar.xz -C /opt/vulkan --strip-components=2 "${VULKAN_SDK_VERSION}/x86_64" \
    && rm /tmp/vulkan-sdk.tar.xz \
    && /opt/vulkan/bin/glslc --version

# FindVulkan reads VULKAN_SDK; glslc must be on PATH for ggml-vulkan's shader step.
ENV VULKAN_SDK=/opt/vulkan
ENV PATH="/opt/vulkan/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/vulkan/lib"

# Install Rust via rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
COPY . .

ENV CARGO_BUILD_JOBS=${BUILD_JOBS}
ENV CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS}
ENV MAKEFLAGS="-j${BUILD_JOBS}"

# Same ISA floor and flags as Dockerfile.vulkan (Haswell, no AVX-512/GFNI/SSE4a).
ENV RUSTFLAGS="-C target-cpu=haswell -C target-feature=-avx512f,-avx512bw,-avx512cd,-avx512dq,-avx512vl,-gfni,-sse4a,-avxvnni -C lto=off -C codegen-units=8"
ENV GGML_NATIVE=OFF
ENV GGML_AVX512=OFF
ENV GGML_AVX_VNNI=OFF
ENV GGML_AVX512_VNNI=OFF
ENV CMAKE_C_FLAGS="-mno-avx512f -mno-avx512vl -mno-avx512bw -mno-avx512dq -mno-avx512cd -mno-gfni -mno-avxvnni -mno-sha -mno-vaes -mno-vpclmulqdq"
ENV CMAKE_CXX_FLAGS="-mno-avx512f -mno-avx512vl -mno-avx512bw -mno-avx512dq -mno-avx512cd -mno-gfni -mno-avxvnni -mno-sha -mno-vaes -mno-vpclmulqdq"

RUN cargo build --release --features gpu-vulkan \
    --config 'profile.release.lto=false' \
    --config 'profile.release.codegen-units=8' \
    -vv 2>&1 | tee /tmp/build.log \
    && cp target/release/voxtype /tmp/voxtype-vulkan

# The point of this image: the binary must not need a newer glibc than 22.04's.
RUN echo "=== Verifying glibc floor (max ${MAX_GLIBC}) ===" \
    && need=$(objdump -T /tmp/voxtype-vulkan | grep -oE 'GLIBC_[0-9.]+' | sed 's/GLIBC_//' | sort -Vu | tail -1) \
    && echo "  highest GLIBC symbol version required: ${need}" \
    && if [ "$(printf '%s\n%s\n' "${MAX_GLIBC}" "${need}" | sort -V | tail -1)" != "${MAX_GLIBC}" ]; then \
         echo "ERROR: binary needs glibc ${need}, newer than ${MAX_GLIBC}" && exit 1; \
       fi \
    && echo "✓ runs on glibc ${MAX_GLIBC} and newer"

# Same ISA-floor gate as Dockerfile.vulkan (Haswell / x86_64-v3, no SSE4a).
RUN echo "=== Verifying Vulkan binary ISA floor (x86_64-v3 / Haswell, no SSE4a) ===" \
    && DUMP=$(objdump -d /tmp/voxtype-vulkan) \
    && zmm_count=$(echo "$DUMP" | grep -c zmm || true) \
    && avx512_count=$(echo "$DUMP" | grep -cE 'vpternlog|vpermt2|vpermi2|vpblendm|valign[dq]|vpcompress|vpexpand' || true) \
    && broadcast_count=$(echo "$DUMP" | grep -c '{1to' || true) \
    && gfni_count=$(echo "$DUMP" | grep -cE '\b(vgf2p8|gf2p8)' || true) \
    && sse4a_count=$(echo "$DUMP" | grep -cE '\b(insertq|extrq)\b' || true) \
    && avxvnni_count=$(echo "$DUMP" | grep -cE '\bvpdpbus(d|ds)|vpdpwss(d|ds)' || true) \
    && echo "  zmm registers:     $zmm_count" \
    && echo "  AVX-512 EVEX:      $avx512_count" \
    && echo "  AVX-512 broadcast: $broadcast_count" \
    && echo "  GFNI:              $gfni_count" \
    && echo "  SSE4a (AMD-only):  $sse4a_count" \
    && echo "  AVX-VNNI:          $avxvnni_count" \
    && if [ "${zmm_count:-0}" -gt 0 ] || [ "${avx512_count:-0}" -gt 0 ] \
         || [ "${broadcast_count:-0}" -gt 0 ] || [ "${gfni_count:-0}" -gt 0 ] \
         || [ "${sse4a_count:-0}" -gt 0 ] || [ "${avxvnni_count:-0}" -gt 0 ]; then \
         echo "ERROR: Vulkan binary contains out-of-floor instructions" && exit 1; \
       fi \
    && echo "✓ Vulkan binary is clean"

# Output stage - copy binary to /output volume. Same asset name as the 24.04
# build is deliberately NOT reused; see the suffix.
CMD mkdir -p /output \
    && cp /tmp/voxtype-vulkan /output/voxtype-${VERSION}-linux-x86_64-vulkan-glibc235 \
    && chmod 755 /output/voxtype-${VERSION}-linux-x86_64-vulkan-glibc235 \
    && echo "Binary copied to /output:" \
    && ls -la /output/voxtype-*-vulkan-glibc235
